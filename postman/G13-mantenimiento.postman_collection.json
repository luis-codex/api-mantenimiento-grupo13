  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const primera = pm.info.requestName === \"Listar equipos\";",
          "if (primera || !pm.collectionVariables.get(\"serialEquipo\")) {",
          "  const id = Date.now().toString(36).toUpperCase();",
          "  pm.collectionVariables.set(\"serialEquipo\", \"EQ-DEMO-\" + id);",
          "  pm.collectionVariables.set(\"serialPersistente\", \"EQ-KEEP-\" + id);",
          "  pm.collectionVariables.set(\"emailTecnico\", \"tecnico-\" + id.toLowerCase() + \"@example.edu\");",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const req = pm.request, code = pm.response.code, name = pm.info.requestName;",
          "const path = \"/\" + req.url.path.join(\"/\");",
          "if (req.method === \"POST\" && code === 201) {",
          "  const id = pm.response.json().id;",
          "  if (path === \"/api/equipos\") {",
          "    if (name.includes(\"persistente\")) { pm.collectionVariables.set(\"equipoPersistenteId\", id); pm.collectionVariables.set(\"equipoId\", id); }",
          "    else pm.collectionVariables.set(\"equipoCrudId\", id);",
          "  }",
          "  if (path === \"/api/tecnicos\") pm.collectionVariables.set(\"tecnicoId\", id);",
          "  if (path === \"/api/mantenimientos\") pm.collectionVariables.set(\"mantenimientoId\", id);",
          "  if (path === \"/api/ordenes\") pm.collectionVariables.set(\"ordenId\", id);",
          "}",
          "const esperado = (name.match(/^(?:Regla )?(\\d{3})[: ]/) || [])[1];",
          "if (esperado) pm.test(name + \" devuelve \" + esperado, () => pm.response.to.have.status(Number(esperado)));",
          "else pm.test(name + \" responde 2xx\", () => pm.expect(code).to.be.within(200, 299));"
        ]
      }
    }
  ]
}
