  "item": [
    {
      "name": "Equipos",
      "item": [
        {
          "name": "Listar equipos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipos"
          }
        },
        {
          "name": "Consultar equipo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipos/{{equipoId}}"
          }
        },
        {
          "name": "Crear equipo temporal para CRUD",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serial\":\"{{serialEquipo}}\",\"nombre\":\"Equipo temporal\",\"ubicacion\":\"Taller G13\",\"activo\":true}"
            },
            "url": "{{baseUrl}}/api/equipos"
          }
        },
        {
          "name": "Crear equipo persistente para consulta PostgreSQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serial\":\"{{serialPersistente}}\",\"nombre\":\"Equipo persistente de demostración\",\"ubicacion\":\"Taller G13\",\"activo\":true}"
            },
            "url": "{{baseUrl}}/api/equipos"
          }
        },
        {
          "name": "Consultar equipo temporal CRUD",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipos/{{equipoCrudId}}"
          }
        },
        {
          "name": "Actualizar equipo temporal CRUD",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serial\":\"{{serialEquipo}}\",\"nombre\":\"Equipo actualizado\",\"ubicacion\":\"Taller G13\",\"activo\":true}"
            },
            "url": "{{baseUrl}}/api/equipos/{{equipoCrudId}}"
          }
        },
        {
          "name": "Eliminar equipo temporal CRUD",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipos/{{equipoCrudId}}"
          }
        },
        {
          "name": "404: recurso inexistente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipos/999999999"
          }
        }
      ]
    },
    {
      "name": "Técnicos",
      "item": [
        {
          "name": "Listar técnicos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tecnicos"
          }
        },
        {
          "name": "Buscar técnicos por especialidad",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tecnicos?especialidad=Mec%C3%A1nica"
          }
        },
        {
          "name": "Consultar técnico",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}"
          }
        },
        {
          "name": "Crear técnico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"Técnico de demostración\",\"email\":\"{{emailTecnico}}\",\"especialidad\":\"Mecánica\",\"activo\":true}"
            },
            "url": "{{baseUrl}}/api/tecnicos"
          }
        },
        {
          "name": "Actualizar técnico",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"Técnico de demostración\",\"email\":\"{{emailTecnico}}\",\"especialidad\":\"Mecánica\",\"activo\":true}"
            },
            "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}"
          }
        },
        {
          "name": "Eliminar técnico",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tecnicos/{{tecnicoId}}"
          }
        }
      ]
    },
    {
      "name": "Mantenimientos",
      "item": [
        {
          "name": "Listar mantenimientos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mantenimientos"
          }
        },
        {
          "name": "Listar por técnico (JPQL)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mantenimientos?tecnicoId={{tecnicoId}}"
          }
        },
        {
          "name": "Listar pendientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mantenimientos/pendientes"
          }
        },
        {
          "name": "Consultar mantenimiento",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mantenimientos/{{mantenimientoId}}"
          }
        },
        {
          "name": "Crear mantenimiento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"equipoId\":{{equipoId}},\"tecnicoId\":{{tecnicoId}},\"fechaProgramada\":\"{{fechaProgramada}}\",\"descripcion\":\"Mantenimiento preventivo de demostración\"}"
            },
            "url": "{{baseUrl}}/api/mantenimientos"
          }
        },
        {
          "name": "Actualizar mantenimiento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"equipoId\":{{equipoId}},\"tecnicoId\":{{tecnicoId}},\"fechaProgramada\":\"{{fechaProgramada}}\",\"descripcion\":\"Mantenimiento actualizado de demostración\"}"
            },
            "url": "{{baseUrl}}/api/mantenimientos/{{mantenimientoId}}"
          }
        },
        {
          "name": "Eliminar mantenimiento",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/mantenimientos/{{mantenimientoId}}"
          }
        },
        {
          "name": "Regla 409: solapamiento de técnico en la misma hora",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"equipoId\":{{equipoId}},\"tecnicoId\":{{tecnicoId}},\"fechaProgramada\":\"{{fechaProgramada}}\",\"descripcion\":\"Intento duplicado para la demostración\"}"
            },
            "url": "{{baseUrl}}/api/mantenimientos"
          }
        },
        {
          "name": "Regla 422: fecha pasada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"equipoId\":{{equipoId}},\"tecnicoId\":{{tecnicoId}},\"fechaProgramada\":\"2000-01-01T10:00:00\",\"descripcion\":\"Fecha pasada para la demostración\"}"
            },
            "url": "{{baseUrl}}/api/mantenimientos"
          }
        }
      ]
    },
    {
      "name": "Órdenes de trabajo",
      "item": [
        {
          "name": "Listar órdenes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordenes"
          }
        },
        {
          "name": "Filtrar por estado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordenes?estado=PENDIENTE"
          }
        },
        {
          "name": "Filtrar por equipo y estado (JPQL)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordenes/equipo/{{equipoId}}?estado=PENDIENTE"
          }
        },
        {
          "name": "Consultar orden",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}"
          }
        },
        {
          "name": "Crear orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mantenimientoId\":{{mantenimientoId}},\"descripcion\":\"Inspección de rutina\"}"
            },
            "url": "{{baseUrl}}/api/ordenes"
          }
        },
        {
          "name": "Actualizar orden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mantenimientoId\":{{mantenimientoId}},\"descripcion\":\"Inspección actualizada\"}"
            },
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}"
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"estado\":\"EN_PROCESO\"}"
            },
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/estado"
          }
        },
        {
          "name": "Eliminar orden",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}"
          }
        }
      ]
    }
  ]
}
